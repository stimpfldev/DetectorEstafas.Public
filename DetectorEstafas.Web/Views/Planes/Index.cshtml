@using DetectorEstafas.Web.Models.ApiComercial
@{
    ViewData["Title"] = "Planes";
}

<section class="container py-5">
    <div class="text-center mb-5">
        <h1>Planes para integrar AlertaEstafa</h1>
        <p class="lead">
            Para desarrolladores y empresas que necesitan utilizar el análisis de AlertaEstafa desde sus propios sistemas mediante API.
        </p>
    </div>

    <div class="card card-body bg-light border-0 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h2 class="h5 mb-1">¿Querés probar la API primero?</h2>
                <p class="mb-0">
                    Prueba gratuita durante 14 días, con hasta @ApiPlanes.CuotaDiariaPrueba análisis por día.
                </p>
            </div>
            <a asp-action="Prueba"
               class="btn btn-outline-primary flex-shrink-0">
                Probar gratis
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <article class="card h-100 shadow-sm border-primary">
                <div class="card-body d-flex flex-column">
                    <h2 class="h4">Starter</h2>
                    <div class="display-6 mb-1">USD @ApiPlanes.PrecioReferenciaUsdStarter</div>
                    <p class="text-muted">por mes</p>
                    <ul>
                        <li>@ApiPlanes.CuotaMensualStarter.ToString("N0") análisis por mes</li>
                        <li>Clave de acceso individual</li>
                        <li>Alta automática</li>
                        <li>Suscripción recurrente mediante Mercado Pago</li>
                    </ul>
                    <a asp-action="Suscripcion"
                       asp-route-plan="@ApiPlanes.Starter"
                       class="btn btn-primary mt-auto">
                        Suscribirme
                    </a>
                </div>
            </article>
        </div>

        <div class="col-md-4">
            <article class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h4">Growth</h2>
                    <div class="display-6 mb-1">USD @ApiPlanes.PrecioReferenciaUsdGrowth</div>
                    <p class="text-muted">por mes</p>
                    <ul>
                        <li>@ApiPlanes.CuotaMensualGrowth.ToString("N0") análisis por mes</li>
                        <li>Clave de acceso individual</li>
                        <li>Alta automática</li>
                        <li>Suscripción recurrente mediante Mercado Pago</li>
                    </ul>
                    <a asp-action="Suscripcion"
                       asp-route-plan="@ApiPlanes.Growth"
                       class="btn btn-primary mt-auto">
                        Suscribirme
                    </a>
                </div>
            </article>
        </div>

        <div class="col-md-4">
            <article class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h4">A medida</h2>
                    <div class="display-6 mb-3">Consultar</div>
                    <ul>
                        <li>Capacidad personalizada</li>
                        <li>Cuota mensual configurable</li>
                        <li>Condiciones comerciales personalizadas</li>
                        <li>Atención directa</li>
                    </ul>
                    <a asp-controller="Contacto"
                       asp-action="Index"
                       class="btn btn-outline-secondary mt-auto">
                        Contactar
                    </a>
                </div>
            </article>
        </div>
    </div>

    <div class="card card-body bg-light border-0 mt-4">
        <h2 class="h5">¿Cómo funciona la suscripción?</h2>
        <p class="mb-0">
            Elegís Starter o Growth, completás tus datos y continuás a Mercado Pago. Una vez aprobado el pago, el sistema procesa la confirmación y habilita el acceso técnico a la API.
        </p>
    </div>

    <p class="small text-muted mt-4 text-center">
        Los precios publicados son referencias comerciales en USD. El cobro mediante Mercado Pago se realiza en pesos argentinos por el importe equivalente definido para la suscripción.
    </p>
</section>
