@{
    ViewData["Title"] = "Enlace no disponible";
    ViewData["DisableGoogleAnalytics"] = true;
}

<section class="shared-result-page">
    <div class="container">
        <div class="shared-result-card">
            <span class="section-label">Resultado compartido</span>

            <h1>Este enlace no está disponible</h1>

            <p>
                El vínculo es inválido, fue modificado o ya venció.
            </p>

            <a asp-controller="Analisis"
               asp-action="Index"
               asp-fragment="analizador"
               class="btn btn-primary">
                Ir al analizador
            </a>
        </div>
    </div>
</section>
