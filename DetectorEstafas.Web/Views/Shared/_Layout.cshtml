@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var googleAnalyticsEnabled =
        string.Equals(
            Configuration["GoogleAnalytics:Enabled"],
            "true",
            StringComparison.OrdinalIgnoreCase);

    var googleAnalyticsMeasurementId =
        Configuration["GoogleAnalytics:MeasurementId"];

    var currentPath =
        Context.Request.Path.Value ?? string.Empty;

    var canonicalPath =
        string.IsNullOrWhiteSpace(currentPath)
            ? "/"
            : currentPath;

    var canonicalUrl =
        $"https://alertaestafa.com.ar{canonicalPath}";

    var selectedLanguage =
        Context.Request.Cookies["AlertaEstafa.Language"];

    var isEnglish =
        string.Equals(
            selectedLanguage,
            "en",
            StringComparison.OrdinalIgnoreCase);

    var language = isEnglish ? "en" : "es";
    var alternateLanguage = isEnglish ? "es" : "en";

    var returnUrl =
        $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";

    var sensitiveGoogleAnalyticsPath =
        currentPath.StartsWith(
            "/Cuenta",
            StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith(
            "/AdministracionApi",
            StringComparison.OrdinalIgnoreCase);

    var disableGoogleAnalytics =
        (ViewData["DisableGoogleAnalytics"] as bool? ?? false)
        || sensitiveGoogleAnalyticsPath;

    var loadGoogleAnalytics =
        googleAnalyticsEnabled
        && !string.IsNullOrWhiteSpace(googleAnalyticsMeasurementId)
        && !disableGoogleAnalytics;

    var secondaryPublicPage =
        currentPath.StartsWith("/Planes", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/Contacto", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/Cuenta", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/Legal", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/AccesoApi", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/ResultadosCompartidos", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@language">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <meta name="description"
          content="@(isEnglish
              ? "AlertaEstafa analyzes suspicious messages, links, phone numbers, and calls before you act."
              : "AlertaEstafa analiza mensajes, enlaces, teléfonos y llamadas sospechosas antes de actuar.")" />

    <link rel="canonical"
          href="@canonicalUrl" />

    <meta name="theme-color"
          content="#0f172a" />
@if (loadGoogleAnalytics)
{
    <meta name="google-analytics-measurement-id"
          content="@googleAnalyticsMeasurementId" />
}
    <meta name="mobile-web-app-capable"
          content="yes" />

    <meta name="apple-mobile-web-app-capable"
          content="yes" />

    <meta name="apple-mobile-web-app-status-bar-style"
          content="black-translucent" />

    <meta name="apple-mobile-web-app-title"
          content="AlertaEstafa" />

    <title>@ViewData["Title"] - AlertaEstafa</title>

    <link rel="manifest"
          href="~/manifest.webmanifest" />

    <link rel="apple-touch-icon"
          href="~/icons/apple-touch-icon.png" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/functional-fixes.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/shark-hosting.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand"
                   asp-controller="Analisis"
                   asp-action="Index">

                    <span class="brand-icon">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M12 2 20 5v6c0 5.1-3.4 9.8-8 11-4.6-1.2-8-5.9-8-11V5l8-3Z" />
                            <path d="m9 12 2 2 4-5" />
                        </svg>
                    </span>

                    <span class="brand-text">
                        AlertaEstafa
                    </span>
                </a>

                <div class="header-actions">
                    <a asp-controller="Analisis"
                       asp-action="Index"
                       class="btn btn-outline-light header-nav-link">
                        @(isEnglish ? "Home" : "Inicio")
                    </a>

                    <a asp-controller="Planes"
                       asp-action="Index"
                       class="btn btn-outline-light header-nav-link">
                        @(isEnglish ? "Plans" : "Planes")
                    </a>

                    <a asp-controller="Contacto"
                       asp-action="Index"
                       class="btn btn-outline-light header-nav-link">
                        @(isEnglish ? "Contact" : "Contacto")
                    </a>

                    <a asp-controller="Cuenta"
                       asp-action="Registrarse"
                       class="btn btn-outline-light header-nav-link">
                        @(isEnglish ? "Create account" : "Crear cuenta")
                    </a>

                    <button id="installAppButton"
                            type="button"
                            class="btn btn-outline-light header-nav-link btn-install-app">
                        @(isEnglish ? "Install app" : "Instalar aplicación")
                    </button>

                    <a asp-controller="Idioma"
                       asp-action="Cambiar"
                       asp-route-culture="@alternateLanguage"
                       asp-route-returnUrl="@returnUrl"
                       class="btn btn-outline-light header-nav-link language-switch"
                       lang="@alternateLanguage"
                       hreflang="@alternateLanguage"
                       aria-label="@(isEnglish ? "Cambiar a español" : "Switch to English")"
                       title="@(isEnglish ? "Cambiar a español" : "Switch to English")">
                        @(isEnglish ? "ES" : "EN")
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1 @(secondaryPublicPage ? "secondary-public-page" : string.Empty)">
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        <div class="container">
            <div class="footer-content">
                <div>
                    <strong>AlertaEstafa</strong>

                    <p>
                        @(isEnglish
                            ? "A preventive tool to identify warning signs before replying, opening a link, or transferring money."
                            : "Herramienta preventiva para identificar señales de riesgo antes de responder, abrir un enlace o transferir dinero.")
                    </p>
                </div>

                <div class="footer-disclaimer">
                    @(isEnglish
                        ? "Results are for guidance only and do not guarantee that a communication is safe or fraudulent."
                        : "El resultado es orientativo y no garantiza que una comunicación sea segura o fraudulenta.")
                </div>
            </div>

            <div class="footer-bottom">
                © @DateTime.Now.Year AlertaEstafa
            </div>

            <nav class="footer-legal-links"
                 aria-label="@(isEnglish ? "Site information" : "Información del sitio")">

                <a asp-controller="Analisis"
                   asp-action="Index">
                    @(isEnglish ? "Home" : "Inicio")
                </a>

                <a asp-controller="Planes"
                   asp-action="Index">
                    @(isEnglish ? "Plans" : "Planes")
                </a>

                <a asp-controller="Cuenta"
                   asp-action="Registrarse">
                    @(isEnglish ? "Create account" : "Crear cuenta")
                </a>

                <a asp-controller="Contacto"
                   asp-action="Index">
                    @(isEnglish ? "Contact" : "Contacto")
                </a>

                <a asp-controller="Legal"
                   asp-action="Privacidad">
                    @(isEnglish ? "Privacy" : "Privacidad")
                </a>

                <a asp-controller="Legal"
                   asp-action="Condiciones">
                    @(isEnglish ? "Terms of use" : "Condiciones de uso")
                </a>

                <a asp-controller="Legal"
                   asp-action="Terceros">
                    @(isEnglish ? "Licenses and third parties" : "Licencias y terceros")
                </a>
            </nav>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/functional-fixes.js"
            asp-append-version="true"></script>

    <script src="~/js/pwa.js"
            asp-append-version="true"></script>

    <script src="~/js/i18n.js"
            asp-append-version="true"></script>

    <script src="~/js/google-analytics.js"
            asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
