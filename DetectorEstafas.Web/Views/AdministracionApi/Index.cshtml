@using DetectorEstafas.Web.Models.ApiComercial
@model DetectorEstafas.Web.ViewModels.ApiAdministracion.ApiDashboardViewModel

@{
    ViewData["Title"] = "Dashboard de API";
}

<section class="admin-api-dashboard container">
    <div class="admin-api-heading">
        <div>
            <h1>Dashboard de API</h1>
            <p>Consumo al @Model.FechaUtc.ToString("dd/MM/yyyy") en UTC.</p>
        </div>

        <form asp-action="Salir" method="post">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="btn btn-outline-secondary">
                Cerrar administración
            </button>
        </form>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="admin-api-summary">
        <article>
            <span>Clientes</span>
            <strong>@Model.TotalClientes</strong>
        </article>
        <article>
            <span>Habilitados</span>
            <strong>@Model.ClientesHabilitados</strong>
        </article>
        <article>
            <span>Solicitudes hoy</span>
            <strong>@Model.SolicitudesHoy</strong>
        </article>
    </div>

    @if (Model.Clientes.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no existen clientes API registrados.
        </div>
    }
    else
    {
        <div class="admin-api-clients">
            @foreach (var cliente in Model.Clientes)
            {
                <article class="admin-api-client-card">
                    <div class="admin-api-client-header">
                        <div>
                            <h2>@cliente.Nombre</h2>
                            <span class="badge @(cliente.Habilitado ? "text-bg-success" : "text-bg-secondary")">
                                @(cliente.Habilitado ? "Habilitado" : "Deshabilitado")
                            </span>
                        </div>

                        <form asp-action="CambiarEstadoCliente"
                              asp-route-apiClienteId="@cliente.ApiClienteId"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm @(cliente.Habilitado ? "btn-outline-danger" : "btn-outline-success")">
                                @(cliente.Habilitado ? "Deshabilitar" : "Habilitar")
                            </button>
                        </form>
                    </div>

                    @if (!cliente.ConfiguracionCuotaValida)
                    {
                        <div class="alert alert-warning">
                            La configuración de cuota de este cliente no es válida.
                        </div>
                    }

                    <dl class="admin-api-metrics">
                        <div>
                            <dt>Plan</dt>
                            <dd>@cliente.Plan</dd>
                        </div>
                        <div>
                            <dt>Límite</dt>
                            <dd>@cliente.LimitePeriodo / @cliente.PeriodoTexto</dd>
                        </div>
                        <div>
                            <dt>Consumidas</dt>
                            <dd>@cliente.ConsumidasPeriodo</dd>
                        </div>
                        <div>
                            <dt>Restantes</dt>
                            <dd>@cliente.RestantesPeriodo</dd>
                        </div>
                    </dl>

                    @if (cliente.ConfiguracionCuotaValida)
                    {
                        <p class="small text-muted">
                            La cuota actual se reinicia el
                            @cliente.ReiniciaUtc.ToString("dd/MM/yyyy HH:mm")
                            UTC.
                        </p>
                    }

                    <form asp-action="ActualizarPlanCliente"
                          asp-route-apiClienteId="@cliente.ApiClienteId"
                          method="post"
                          class="row g-2 align-items-end mb-4">
                        @Html.AntiForgeryToken()

                        <div class="col-md-4">
                            <label class="form-label">Plan</label>
                            <select name="plan"
                                    class="form-select">
                                @foreach (string plan in ApiPlanes.Todos)
                                {
                                    if (string.Equals(
                                        cliente.Plan,
                                        plan,
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@plan" selected>@plan</option>
                                    }
                                    else
                                    {
                                        <option value="@plan">@plan</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Cuota mensual personalizada
                            </label>
                            <input type="number"
                                   name="cuotaMensualPersonalizada"
                                   min="1"
                                   max="@ApiPlanes.CuotaMensualMaximaPersonalizada"
                                   value="@cliente.CuotaMensualPersonalizada"
                                   placeholder="Solo para A medida"
                                   class="form-control" />
                            <div class="form-text">
                                Prueba: 200/día · Starter: 5.000/mes · Growth: 25.000/mes.
                            </div>
                        </div>

                        <div class="col-md-4">
                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Actualizar plan
                            </button>
                        </div>
                    </form>

                    <h3>Claves</h3>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Prefijo</th>
                                    <th>Creada UTC</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var clave in cliente.Claves)
                            {
                                <tr>
                                    <td><code>@clave.Prefijo…</code></td>
                                    <td>@clave.FechaCreacionUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(clave.Habilitada ? "Activa" : "Revocada")</td>
                                    <td class="text-end">
                                    @if (clave.Habilitada)
                                    {
                                        <form asp-action="RevocarClave"
                                              asp-route-apiClaveId="@clave.ApiClaveId"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Revocar
                                            </button>
                                        </form>
                                    }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </article>
            }
        </div>
    }
</section>
