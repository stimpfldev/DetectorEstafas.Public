@model DetectorEstafas.Web.ViewModels.ApiAdministracion.ApiAdministracionLoginViewModel

@{
    ViewData["Title"] = "Administración de API";
}

<section class="admin-api-login container">
    <div class="admin-api-login-card">
        <h1>Administración de API</h1>
        <p>Acceso interno para consultar clientes, cuotas y claves.</p>

        <form asp-action="Ingresar" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <label asp-for="Secret">Clave administrativa</label>
            <input asp-for="Secret"
                   class="form-control"
                   autocomplete="current-password" />
            <span asp-validation-for="Secret"
                  class="text-danger"></span>

            <button type="submit"
                    class="btn btn-primary mt-3">
                Ingresar
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
